<header class="masthead">
  <a class="masthead__brand" href="<%= root_path %>">Tastemaker</a>
  <p class="masthead__label">The full gallery</p>
  <span class="masthead__aside"><%= @total %> works · Mia</span>
</header>

<%# The overlay lives here, next to the frames the archive streams into, so every
    work that arrives with infinite scroll is inside the controller. %>
<main class="page" data-controller="artwork">
  <%= render "page", paintings: @paintings, page: @page, next_page: @next_page %>

  <%= render "shared/zoom" %>
</main>
