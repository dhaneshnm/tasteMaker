<%# `compass: false` — this is the one screen whose compass is not in the
    masthead. See the rail below. %>
<%= render "shared/masthead", label: "The full gallery",
      aside: "#{@total} works · Mia", compass: false %>

<%# The gallery is the only unbounded screen in the product: 110 works of
    infinite scroll, a masthead that is never sticky (DESIGN.md rule 5), and a
    coda that only renders on the last page. Two flicks in there was no way out
    on screen at all, which is the defect story 0012 exists to fix.

    So the compass rides in its own sticky rail rather than in the masthead. At
    the top of the page it reads as the compass sitting under the bar, exactly
    like every other screen; once you scroll it is 58px of links and nothing
    else. No JavaScript: there is no cross-browser way for CSS to know it has
    become stuck, so nothing here changes shape — the masthead simply scrolls
    away and the rail does not. %>
<%= render "shared/compass", here: :gallery, rail: true %>

<%# Filter facets (story 0022 Release 1: period, genre; story 0024:
    tradition) — one row per lit facet, directly under the compass rail,
    before the first post. Each row renders nothing when its values are
    empty (the non-empty rule, `_facet_row`'s caller-only-renders-when-
    non-empty contract) — a page with none lit is byte-identical to before
    any of these three stories. %>
<%= render "facet_row", facet_label: "period", param_name: :period,
      values: @period_values, active: @period,
      preserve: @filter_params.except(:period) if @period_values.present? %>
<%= render "facet_row", facet_label: "genre", param_name: :genre,
      values: @genre_values, active: @genre,
      preserve: @filter_params.except(:genre) if @genre_values.present? %>
<%= render "facet_row", facet_label: "tradition", param_name: :tradition,
      values: @tradition_values, active: @tradition,
      preserve: @filter_params.except(:tradition) if @tradition_values.present? %>

<%# The overlay lives here, next to the frames the archive streams into, so every
    work that arrives with infinite scroll is inside the controller. %>
<main class="page<%= " page--empty" if @total.zero? %>" data-controller="artwork">
  <% if @total.zero? %>
    <%# Combined filters can AND to zero even when every offered value has
        works of its own (design review pass 2) — genre=portrait has works,
        period=16th-century has works, their intersection may not. An empty
        state is a feature: warmth, a way out, context. %>
    <div class="ornament" aria-hidden="true">✦</div>
    <p class="coda__line">Nothing here wears both.</p>
    <%= link_to "See the full gallery", feed_path, class: "caps-link" %>
  <% else %>
    <%= render "page", paintings: @paintings, page: @page, next_page: @next_page,
          kept_ids: @kept_ids, filtered: @filtered, filter_params: @filter_params %>
  <% end %>

  <%= render "shared/zoom" %>
</main>
