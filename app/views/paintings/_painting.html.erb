<article class="post" data-controller="reveal" id="painting_<%= painting.dom_key %>">
  <%= render "shared/plate", painting: painting, eager: painting_counter < 2,
        describedby: nil, resting: "This work is resting." %>

  <div class="label">
    <h2 class="label__title <%= "label__title--long" if painting.long_title? %>"><%= painting.title %></h2>
    <%# `show_artist:` default true. The artist page passes false — the name
        already carries the h1 there, and rendering it again under every work
        would repeat it once per work (design review D2). %>
    <%= render "shared/artist_line", painting: painting if local_assigns.fetch(:show_artist, true) %>
    <% if painting.meta_line.present? %>
      <p class="label__meta"><%= painting.meta_line %></p>
    <% end %>

    <% if painting.description.present? %>
      <div class="label__body" data-controller="expand">
        <p class="label__text" data-expand-target="text"><%= painting.description %></p>
        <button type="button" class="label__more" data-expand-target="button" data-action="expand#toggle" hidden>More</button>
      </div>
    <% end %>

    <p class="label__credit"><%= painting.credit_line %></p>
  </div>
</article>
