<%# Every answer the impression frame can give (story 0032, redesigned
    2026-09-01). Locals: painting (required), impression (the reader's
    draft/answer or nil), revealed (true on the after=reveal fetch).

    The frame id matches the front door's inert frame in every state — an
    unmatched response is Turbo's "Content missing" painted over the calm
    page (eng A1). Privacy order: the answer only for its author; the field
    only for a signed-in reader still looking; the sign-in hint (plain text,
    no link, no form, no cookie — the wall's 401 frame carries a link and
    must never appear here) for everyone else pre-reveal; and after the
    reveal, silence for anyone without an answer — a hint under an open
    note would be a nag. %>
<%= turbo_frame_tag "impression_#{painting.id}", class: "sit__slot" do %>
  <% if revealed %>
    <% if impression %>
      <%# The reader's own voice above the curator's (F1: the frame renders
          before the details, so this sits above the note by DOM order). %>
      <p class="sit__impression"><%= impression.body %></p>
    <% end %>
  <% elsif current_user %>
    <%# No submit button, no Turbo: autosave_controller owns every write.
        The day's prompt is the field's visible label (aria-labelledby);
        the placeholder is a hint beside it, never the label itself. %>
    <%= form_with url: impression_path(painting), method: :post,
          class: "sit__form", data: { controller: "autosave", turbo: false } do %>
      <input type="text" name="body" class="sit__input"
             maxlength="280" value="<%= impression&.body %>"
             aria-labelledby="sit-prompt"
             placeholder="Write here — even one line will do."
             data-autosave-target="input"
             data-action="input->autosave#changed keydown->autosave#keydown blur->autosave#blurred">
      <p class="sit__saved" aria-live="polite" data-autosave-target="status"
         data-saved-copy="Saved"></p>
    <% end %>
  <% else %>
    <p class="sit__hint">Sign in to keep your answer.</p>
  <% end %>
<% end %>
