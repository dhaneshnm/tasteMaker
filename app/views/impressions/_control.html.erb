<%# Every answer the impression frame can give (story 0032). Locals:
    painting (required), impression — the reader's saved line, an invalid
    attempt carrying errors and the reader's text, or nil.

    The frame id matches the front door's inert frame in every state — an
    unmatched response is Turbo's "Content missing" painted over the calm
    page (eng A1). Order of the branches is the privacy order: a line only a
    signed-in author can have, a field only a signed-in reader gets, and
    nothing at all for a device or a stranger — no link, no form, no text
    (the wall's 401 frame carries a sign-in link; this must never). %>
<%= turbo_frame_tag "impression_#{painting.id}", class: "sit__slot" do %>
  <% if impression&.persisted? %>
    <%# The reader's own voice: italic, dim, unquoted, unboxed (design F14).
        It sits above the note by DOM position — the frame renders before the
        details element, so the juxtaposition needs no reparenting (F1). %>
    <p class="sit__impression"><%= impression.body %></p>
  <% elsif current_user %>
    <% error = impression&.errors&.full_messages&.first %>
    <%# DRAFT COPY — owner reviews field by field before ship (T5). %>
    <%= form_with url: impressions_path(painting), method: :post,
          class: "sit__form", data: { turbo_frame: "impression_#{painting.id}" } do %>
      <label for="impression_body" class="sit__label">First impression — one line, before the note</label>
      <input type="text" id="impression_body" name="body" class="sit__input"
             maxlength="280" required value="<%= impression&.body %>"
             <%= tag.attributes("aria-describedby": "impression-error") if error %>>
      <% if error %>
        <%# --warn's one sanctioned job; the reader's text stays in the field. %>
        <p class="sit__error" id="impression-error"><%= error %></p>
      <% end %>
      <button type="submit" class="sit__save caps-link">Set it down</button>
    <% end %>
  <% end %>
<% end %>
