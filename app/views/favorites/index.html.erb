<% content_for :title, "Your collection — Tondo" %>
<% content_for :description, "The works you have kept on Tondo." %>

<%= render "shared/masthead", label: "Your collection", here: :collection,
      aside: pluralize(@rows.size, "work") %>

<main class="page <%= "page--empty" if @rows.empty? %>">
  <% if @rows.empty? %>
    <div class="ornament" aria-hidden="true">✦</div>
    <p class="coda__line">The works you keep will gather here.</p>
    <%# This sentence used to read "Keep this sits under every artwork", naming a
        label that no longer exists — the control is a bookmark glyph now
        (`decisions/0010`). With the labels gone this is the only place in the
        product that can tell a first-time reader what that mark does, so it names
        the shape rather than describing an action. %>
    <p class="coda__note">The bookmark under each artwork keeps it here.</p>
    <%# ISSUE-001 was this page offering only `Today →`, stranding a reader who
        arrived with nothing kept. The compass answers it now, and answers it on
        every screen rather than one at a time. %>
  <% else %>
    <%# Their order, newest kept first — not ours. No month headings: "the month
        I kept it" is not a fact anybody wants. A row with no pick is a work whose
        day the curator removed; it renders unlinked and carries its own Remove,
        because it is the only row whose owner has no other way to let it go. %>
    <ol class="days">
      <% @rows.each_with_index do |(painting, pick), i| %>
        <%= render "days/row", painting: painting, pick: pick,
              current: @current, eager: i < 4 %>
      <% end %>
    </ol>

    <footer class="coda">
      <div class="ornament" aria-hidden="true">✦</div>
      <p class="coda__line">To let one go, open it and unkeep it.</p>
      <%# Said once, quietly, before it can be discovered the hard way. A
          device's keeps live against this device; an account's live with the
          account. Stating the limit up front is what keeps it from reading as
          a betrayal later — see specs/personas.md, persona 6. %>
      <% if current_user %>
        <p class="coda__note">Kept with your account — free, and yours.</p>
      <% else %>
        <p class="coda__note">Kept on this device — free, and yours.</p>
      <% end %>
    </footer>
  <% end %>

  <%# The account row (story 0015, design review D5): rare controls belong in
      the reader's own room, not on every screen. Renders for the account
      world only — a device has no account to administer — and outside the
      empty-state branch, because a reader with nothing kept still owns the
      exit door. The confirm names what it destroys (the one honest dialog in
      the product). %>
  <% if current_user %>
    <footer class="account">
      <p class="coda__note">Signed in with <%= current_user.provider_name %><% if current_user.email.present? %> as <%= current_user.email %><% end %>.</p>
      <%= button_to "Delete account", account_path, method: :delete,
            class: "caps-link account__delete", form_class: "account__form",
            data: { turbo_confirm: "Deletes your account and the #{pluralize(@rows.size, "work")} you've kept. There is no undo." } %>
    </footer>
  <% end %>
</main>
