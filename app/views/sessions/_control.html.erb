<%# The landing page's per-visitor fragment (story 0015, design review D3-D5).
    Local: state — :signed_out | :signed_in | :device

    Like favorites/_control, it carries its own <turbo-frame> so the frame-
    targeted response hands back a matching id. The frame element on `/` also
    carries id="signin" duty: it is the anchor every wall bounce lands on.

    :device renders an empty frame — the app never shows login UI, and that
    includes an UNREGISTERED shell (registration failed or in flight), which is
    why SessionsController#control checks the shell's user agent and not just
    the cookie.

    Rendering the buttons writes the session cookie (their CSRF tokens live in
    the session). Allowed HERE: this response is private + no-store — the 0006
    pattern. The public HTML of `/` stays byte-identical and cookie-free. %>
<%= turbo_frame_tag "signin" do %>
  <% case state %>
  <% when :signed_out %>
    <div class="signin">
      <%# What the door opens, not just how to get through it (D3): every
          gated tap bounces to this sentence. %>
      <p class="signin__note">Sign in to browse past days, wander the gallery,
        and keep a collection of your own.</p>

      <div class="signin__doors">
        <%# House buttons, official marks (D4): recognition lives in the
            logos, not the providers' button chrome. Google's G is the only
            non-token colour in the product — the exception DESIGN.md records. %>
        <%= button_to "/auth/google_oauth2", method: :post, class: "signin__door",
              data: { turbo: false } do %>
          <svg class="signin__mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path fill="#4285F4" d="M23.5 12.27c0-.85-.08-1.66-.22-2.45H12v4.64h6.45a5.52 5.52 0 0 1-2.4 3.62v3h3.88c2.27-2.1 3.57-5.17 3.57-8.81z"/>
            <path fill="#34A853" d="M12 24c3.24 0 5.96-1.07 7.94-2.91l-3.88-3.01c-1.07.72-2.45 1.15-4.06 1.15-3.12 0-5.77-2.11-6.71-4.95H1.28v3.11A12 12 0 0 0 12 24z"/>
            <path fill="#FBBC05" d="M5.29 14.28A7.2 7.2 0 0 1 4.91 12c0-.79.14-1.56.38-2.28V6.61H1.28a12 12 0 0 0 0 10.78l4.01-3.11z"/>
            <path fill="#EA4335" d="M12 4.77c1.76 0 3.34.61 4.58 1.8l3.44-3.44A11.97 11.97 0 0 0 12 0 12 12 0 0 0 1.28 6.61l4.01 3.11C6.23 6.88 8.88 4.77 12 4.77z"/>
          </svg>
          Continue with Google
        <% end %>

        <%= button_to "/auth/apple", method: :post, class: "signin__door",
              data: { turbo: false } do %>
          <svg class="signin__mark" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
            <path d="M16.62 12.9c.03 3.02 2.65 4.02 2.68 4.03-.02.07-.42 1.43-1.38 2.83-.83 1.22-1.7 2.43-3.06 2.45-1.34.03-1.77-.79-3.3-.79-1.53 0-2 .77-3.27.82-1.31.05-2.31-1.32-3.15-2.53C3.42 17.24 2.11 12.73 3.87 9.7a4.9 4.9 0 0 1 4.13-2.51c1.29-.02 2.5.87 3.3.87.78 0 2.27-1.07 3.83-.91.65.03 2.48.26 3.66 1.98-.1.06-2.19 1.28-2.17 3.77zM14.1 5.5c.69-.83 1.15-2 1.02-3.15-.99.04-2.19.66-2.9 1.5-.64.73-1.2 1.92-1.05 3.05 1.1.09 2.23-.56 2.93-1.4z"/>
          </svg>
          Continue with Apple
        <% end %>
      </div>
    </div>
  <% when :signed_in %>
    <%# One quiet line, not a panel (D5, option A): no card, no avatar, no
        email address on the front door. Account administration lives in the
        collection coda. %>
    <div class="signin signin--in">
      <%= link_to "Your collection →", collection_path, class: "caps-link",
            data: { turbo_frame: "_top" } %>
      <%= button_to "Sign out", session_path, method: :delete,
            class: "caps-link signin__out", form_class: "signin__out-form",
            data: { turbo_frame: "_top" } %>
    </div>
  <% end %>
<% end %>
