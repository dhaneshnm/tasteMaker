<%# Every reader-facing page. No CSRF meta tag: these pages carry no forms of
    their own, and emitting one would put a session cookie on a publicly cached
    response. The reasoning lives in layouts/_head.html.erb. %>
<!DOCTYPE html>
<html lang="en">
  <head>
    <%= render "layouts/head" %>
  </head>

  <body>
    <%= yield %>
  </body>
</html>
