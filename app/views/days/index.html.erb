<% content_for :title, "Past days — Tastemaker" %>
<% content_for :description, "Every artwork Tastemaker has published, newest first." %>

<header class="masthead">
  <a class="masthead__brand" href="<%= root_path %>">Tastemaker</a>
  <p class="masthead__label">Past days</p>
  <span class="masthead__aside"><%= pluralize(@picks.size, "day") %></span>
</header>

<main class="page <%= "page--empty" if @picks.empty? %>">
  <% if @picks.empty? %>
    <div class="ornament" aria-hidden="true">✦</div>
    <p class="coda__line">The days will collect here.</p>
    <a class="caps-link" href="<%= feed_path %>">Wander the full gallery →</a>
  <% else %>
    <% @months.each do |month, picks| %>
      <h2 class="days__month"><%= month.strftime("%B %Y") %></h2>

      <ol class="days">
        <% picks.each_with_index do |pick, i| %>
          <%= render "days/row", painting: pick.painting, pick: pick,
                current: @current, eager: i < 4 %>
        <% end %>
      </ol>
    <% end %>

    <footer class="coda">
      <div class="ornament" aria-hidden="true">✦</div>
      <% if @picks.size == 1 %>
        <p class="coda__line">One day so far. Tomorrow this becomes an archive.</p>
      <% end %>
      <%# Countless on purpose: no number means these bytes are the same for every
          visitor, so the door fits on a publicly cached page with no fragment and
          no endpoint. It shows at zero too — the archive and the collection are
          siblings, and an empty collection is how the feature gets discovered. %>
      <a class="caps-link" href="<%= collection_path %>">Your collection →</a>
      <a class="caps-link" href="<%= root_path %>">Today →</a>
    </footer>
  <% end %>
</main>
