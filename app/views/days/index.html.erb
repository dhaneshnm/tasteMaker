<% content_for :title, "Past days — Tastemaker" %>
<% content_for :description, "Every artwork Tastemaker has published, newest first." %>

<header class="masthead">
  <a class="masthead__brand" href="<%= root_path %>">Tastemaker</a>
  <p class="masthead__label">Past days</p>
  <span class="masthead__aside"><%= pluralize(@picks.size, "day") %></span>
</header>

<main class="page <%= "page--empty" if @picks.empty? %>">
  <% if @picks.empty? %>
    <div class="ornament" aria-hidden="true">✦</div>
    <p class="coda__line">The days will collect here.</p>
    <a class="caps-link" href="<%= feed_path %>">Wander the full gallery →</a>
  <% else %>
    <% @months.each do |month, picks| %>
      <h2 class="days__month"><%= month.strftime("%B %Y") %></h2>

      <ol class="days">
        <% picks.each_with_index do |pick, i| %>
          <% painting = pick.painting
             today = pick.scheduled_on == Date.current
             here = pick == @current %>
          <li class="days__day">
            <%# One link per row, named in full: a screen reader hears the date, the
                work and the artist, not a list of bare titles. %>
            <a class="days__link" href="<%= here ? root_path : day_path(pick.scheduled_on.iso8601) %>"
               aria-label="<%= pick.scheduled_on.to_fs(:daily_long) %>: <%= painting.title %>, <%= painting.artist_display %>">
              <span class="days__text">
                <span class="days__date <%= "days__date--now" if here %>">
                  <% if today %>Today · <% end %>
                  <time datetime="<%= pick.scheduled_on.iso8601 %>"><%= pick.scheduled_on.to_fs(:daily) %></time>
                </span>
                <span class="days__title <%= "days__title--long" if painting.long_title? %>"><%= painting.title %></span>
                <span class="days__artist"><%= painting.artist_display %></span>
              </span>

              <span class="days__thumb">
                <%= image_tag artwork_src(painting, size: 240), alt: "",
                      loading: (i < 4 ? "eager" : "lazy"), decoding: "async" %>
              </span>
            </a>
          </li>
        <% end %>
      </ol>
    <% end %>

    <footer class="coda">
      <div class="ornament" aria-hidden="true">✦</div>
      <% if @picks.size == 1 %>
        <p class="coda__line">One day so far. Tomorrow this becomes an archive.</p>
      <% end %>
      <a class="caps-link" href="<%= root_path %>">Today →</a>
    </footer>
  <% end %>
</main>
