<% content_for :title, "Past days — Tondo" %>
<% content_for :description, "Every artwork Tondo has published, newest first." %>

<%= render "shared/masthead", label: "Past days", here: :days,
      aside: pluralize(@picks.size, "day") %>

<main class="page <%= "page--empty" if @picks.empty? %>">
  <% if @picks.empty? %>
    <div class="ornament" aria-hidden="true">✦</div>
    <p class="coda__line">The days will collect here.</p>
  <% else %>
    <% @months.each do |month, picks| %>
      <h2 class="days__month"><%= month.strftime("%B %Y") %></h2>

      <ol class="days">
        <% picks.each_with_index do |pick, i| %>
          <%= render "days/row", painting: pick.painting, pick: pick,
                current: @current, eager: i < 4 %>
        <% end %>
      </ol>
    <% end %>

    <footer class="coda">
      <div class="ornament" aria-hidden="true">✦</div>
      <% if @picks.size == 1 %>
        <p class="coda__line">One day so far. Tomorrow this becomes an archive.</p>
      <% end %>
      <%# The two ways out that used to live here — `Your collection →` and
          `Today →` — are in the compass now, on every screen and in the same
          place. This coda keeps only what it alone can say. %>
    </footer>
  <% end %>

  <%= render "shared/legal" %>
</main>
