<%# The catch-up walk. Somebody back from three shifts moves day to day rather than
    returning to the list between each one.

    "Next day" targets the front door when the next published day is the pick the
    front door is showing — otherwise the last step of every walk pays a 301. %>
<% previous_day = pick.previous_published
   next_day = pick.next_published
   current = DailyPick.current %>

<nav class="walk" aria-label="Move between days">
  <% if previous_day %>
    <%= link_to "← Previous day", day_path(previous_day.scheduled_on.iso8601), class: "caps-link walk__step" %>
  <% else %>
    <span class="walk__step"></span>
  <% end %>

  <% if next_day %>
    <%= link_to "Next day →",
          next_day == current ? root_path : day_path(next_day.scheduled_on.iso8601),
          class: "caps-link walk__step walk__step--next" %>
  <% end %>
</nav>

<% if current && pick != current %>
  <a class="caps-link walk__today" href="<%= root_path %>">Today →</a>
<% end %>
