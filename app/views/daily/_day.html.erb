<%# One day, on every screen that shows one.
    Locals: pick, chrome: — :front_door (/), :archive (/days/:date), :preview (curator),
    and current: — the pick the front door is showing, counted by the controller.

    The three modes differ in four places and nothing else:

      chrome:        masthead label      compass marks  keep control  coda
      ------------   -----------------   -------------  ------------  ----------------------
      :front_door    Artwork of the Day  Today          yes           See you tomorrow. + the gallery
      :archive       From the archive    nothing        yes           prev · next · today
      :preview       Artwork of the Day  Today          NO            See you tomorrow. + the gallery

    An archived day marks nothing, because it is not one of the four surfaces — it is one
    day *inside* the archive, and marking `Days` there would unlink the only route back to
    the list. See ApplicationHelper#compass_destinations.

    :preview shows the reader's page, compass and all, because that is what a preview is
    for. It gets no keep control: the day is not published, so no reader can act on it, and
    a curator keeping unpublished works would be the first thing polluting the only usage
    signal that feature has. %>
<% painting = pick.painting
   src = artwork_src(painting)
   archive = chrome == :archive %>

<% content_for :title, "#{painting.title} — Tondo" %>
<% content_for :description, "#{painting.title} by #{painting.artist_display}, #{archive ? "from the Tondo archive" : "today's artwork on Tondo"}." %>
<% content_for :head do %>
  <link rel="preload" as="image" href="<%= src %>">
<% end %>

<%# The date used to be the door to the archive — a link, but only once there was
    more than one published day, and never labelled as anything but a date. The
    compass carries that door now, with the word `Days` on it and no condition,
    so this is a date again and nothing else. %>
<%= render "shared/masthead",
      label: archive ? "From the archive" : "Artwork of the Day",
      here: archive ? nil : :today,
      aside: pick.scheduled_on.to_fs(:daily),
      aside_datetime: pick.scheduled_on.iso8601 %>

<main class="page" data-controller="artwork">
  <%= render "shared/plate", painting: painting, eager: true,
        describedby: "daily-note", resting: "This work is resting — read the note." %>

  <div class="label">
    <h1 class="label__title <%= "label__title--long" if painting.long_title? %>"><%= painting.title %></h1>

    <p class="label__artist">
      <span class="label__artist-name"><%= painting.artist_display %></span>
      <% if painting.life_date.present? %>
        <span class="label__artist-dates"><%= painting.life_date %></span>
      <% end %>
    </p>

    <% if painting.meta_line.present? %>
      <p class="label__meta"><%= painting.meta_line %></p>
    <% end %>

    <%# The curator's note is shown whole — it is the whole point, and it is
        written to a 60-180 word target. Museum copy is not: it runs to 324
        words in this pool, which would push the artwork off a phone screen. So
        borrowed words get the same clamped treatment they get in the archive,
        and they say whose they are. %>
    <% if pick.hand_written? %>
      <div class="label__note" id="daily-note"><%= simple_format(pick.note) %></div>
    <% else %>
      <div class="label__body" id="daily-note" data-controller="expand">
        <p class="label__text" data-expand-target="text"><%= pick.note %></p>
        <button type="button" class="label__more" data-expand-target="button"
                data-action="expand#toggle" hidden>More</button>
        <p class="label__source">From the Minneapolis Institute of Art</p>
      </div>
    <% end %>

    <%= tag.p(painting.credit_line, class: "label__credit") if painting.credit_line.present? %>

    <%# The last line of the wall label: keeping is an act on the artwork, not a way
        out of the page, so it sits with the label and leaves the coda as the single
        ending. Lazy, because it is below a 55vh plate plus the whole note — a reader
        who bounces at the picture costs no extra request.

        The frame src is the same bytes for every visitor, which is what keeps this
        page publicly cacheable. Everything personal arrives in the fragment. %>
    <% unless chrome == :preview %>
      <%= turbo_frame_tag "keep_#{painting.id}", src: favorite_control_path(painting),
            loading: "lazy", class: "keep-frame" %>
    <% end %>

    <footer class="coda">
      <div class="ornament" aria-hidden="true">✦</div>

      <% if archive %>
        <%= render "days/walk", pick: pick, current: current %>
      <% else %>
        <p class="coda__line">See you tomorrow.</p>
        <a class="caps-link" href="<%= feed_path %>">Wander the full gallery →</a>
      <% end %>
    </footer>
  </div>

  <%= render "shared/zoom" %>
</main>
