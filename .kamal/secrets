# Kamal reads this file at deploy time and injects the values as env vars.
#
# Nothing secret is stored HERE — every line pulls from your shell environment
# or a password manager. This file is committed; the values are not.
#
# Before the first deploy, export both:
#
#   export KAMAL_REGISTRY_PASSWORD=<a GitHub personal access token, scope write:packages>
#   export RAILS_MASTER_KEY=$(cat config/master.key)
#
# config/master.key is gitignored (/config/*.key) and must never be committed —
# it decrypts config/credentials.yml.enc, which holds the curator password.

KAMAL_REGISTRY_PASSWORD=$KAMAL_REGISTRY_PASSWORD
RAILS_MASTER_KEY=$RAILS_MASTER_KEY
