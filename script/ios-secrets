#!/usr/bin/env bash
# Writes `ios/Config/Secrets.xcconfig` from Rails credentials, and fails loudly.
#
# Story 0015's device registration is a shared secret: the shell sends
# `X-Tondo-App`, `DeviceRegistrationsController` compares it to
# `credentials.tondo.app_secret`, and a mismatch is a 401 the shell swallows —
# it routes to the public landing page anyway (plan, constraint 3). So a wrong
# secret does not look like a wrong secret. It looks like an app that will not
# sign anybody in.
#
# The value therefore has exactly one source, the credentials file, and this
# script is the only thing that copies it. `Config/Release.xcconfig` ends with
# `#include? "Secrets.xcconfig"`, which is optional: a fresh clone with no
# secrets file still builds, and gets the readable 401 instead of a hard stop.
#
# Secrets.xcconfig is gitignored. Re-run this after any credentials rotation.
#
# Usage: script/ios-secrets

set -euo pipefail

cd "$(dirname "$0")/.."

OUT="ios/Config/Secrets.xcconfig"

SECRET="$(bin/rails runner 'print Rails.application.credentials.dig(:tondo, :app_secret).to_s')"

if [ -z "$SECRET" ]; then
  echo "credentials.tondo.app_secret is empty — nothing to write." >&2
  echo "Set it with: bin/rails credentials:edit" >&2
  exit 1
fi

# xcconfig has no quoting and no escapes worth trusting. `//` starts a comment
# (the reason TONDO_URL carries a `$()` in the middle), `$(` interpolates
# another setting, and a stray `=` or newline splits the assignment. Rather
# than encode around any of that, refuse: the secret is ours to regenerate.
case "$SECRET" in
  *//*|*'$'*|*'='*|*' '*)
    echo "app_secret contains a character xcconfig cannot carry (// \$ = or space)." >&2
    echo "Regenerate it as hex — SecureRandom.hex(64) — and re-run." >&2
    exit 1
    ;;
esac

cat > "$OUT" <<XCCONFIG
// GENERATED by script/ios-secrets — do not edit, do not commit.
// Source of truth: Rails credentials, \`tondo.app_secret\`.
// Included last by Release.xcconfig so this assignment wins.

TONDO_APP_SECRET = $SECRET
XCCONFIG

chmod 600 "$OUT"

# Never echo the value. Length is enough to tell "wrote it" from "wrote empty".
echo "==> wrote $OUT (${#SECRET} chars, gitignored)"
