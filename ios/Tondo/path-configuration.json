{
  "settings": {},
  "rules": [
    {
      "patterns": [
        "^/$"
      ],
      "properties": {
        "presentation": "clear_all",
        "pull_to_refresh_enabled": true
      }
    },
    {
      "patterns": [
        "^/you$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/feed$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/privacy$",
        "^/support$"
      ],
      "properties": {
        "pull_to_refresh_enabled": false
      }
    },
    {
      "patterns": [
        "^/admin"
      ],
      "properties": {
        "presentation": "none"
      }
    }
  ]
}
