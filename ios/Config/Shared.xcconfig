// Tondo — settings shared by every configuration.
//
// Everything that is not environment-specific lives here. The one thing that
// is — where the shell points — lives in Debug.xcconfig and Release.xcconfig,
// because a start URL hardcoded in Swift is a start URL that ships to the App
// Store pointing at a laptop.

PRODUCT_NAME = Tondo
PRODUCT_BUNDLE_IDENTIFIER = com.dhaneshnm.tondo

// 1.0 is the build in App Review with no push code at all. Story 0010 bumped
// this to 1.1 specifically so the server can tell the two apart — the
// version and the push transport ship in the same binary, same reasoning as
// the auth bridge before it (ApplicationController#push_capable_shell?, the
// 0017 lesson). Story 0031 bumps to 1.2 for the same reason: it is the first
// binary carrying a registered bridge component, and nothing server-side
// needs to gate on this one specifically — the bridge handshake (`bridge-
// components: [share]` in the User-Agent) is its own version signal.
MARKETING_VERSION = 1.2
CURRENT_PROJECT_VERSION = 1

// iOS 17 still covers iPhone XS and later — 2018 hardware. Persona 2 (Jordan)
// is on an old cracked-screen iPhone, so the floor is deliberate, not default.
// The library floor is iOS 14, so this is our choice rather than a constraint.
IPHONEOS_DEPLOYMENT_TARGET = 17.0
TARGETED_DEVICE_FAMILY = 1
SUPPORTED_PLATFORMS = iphoneos iphonesimulator
SDKROOT = iphoneos

// Swift 5 language mode, not 6. Hotwire Native 1.3.0 is not annotated for
// strict concurrency, and adopting Swift 6 mode here would mean fighting
// actor-isolation diagnostics in a story whose subject is a thin shell. This is
// a deliberate deferral, not an oversight.
SWIFT_VERSION = 5.0

INFOPLIST_FILE = Tondo/Info.plist
GENERATE_INFOPLIST_FILE = NO

// Story 0010, the accepted native exception (CLAUDE.md). The Push
// Notifications capability itself is enabled on the App ID in the Apple
// Developer portal (step 0, done); this is what tells the linker which
// entitlements file to sign the binary with.
CODE_SIGN_ENTITLEMENTS = Tondo/Tondo.entitlements
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = Gold

// Apple Developer Team. Same team that issued the Sign in with Apple key in
// Rails credentials (`apple.team_id`) — the two must match or the Apple
// sign-in door breaks on device. A Team ID is not a secret; it is public in
// every provisioning profile. Without it here, a device build cannot sign and
// Xcode fails with "Signing for Tondo requires a development team."
DEVELOPMENT_TEAM = 7UHVJKQDCU

CODE_SIGN_STYLE = Automatic
ENABLE_USER_SCRIPT_SANDBOXING = YES
SWIFT_EMIT_LOC_STRINGS = YES
CLANG_ENABLE_MODULES = YES
ALWAYS_SEARCH_USER_PATHS = NO
