#include "Shared.xcconfig"

// The production host. Must stay in step with `proxy.host` in
// `config/deploy.yml`; the shell builds and runs against this value without
// complaint, so the thing that catches a wrong one is App Review opening a
// dead host. The `$()` is what stops xcconfig treating `//` as a comment.
TONDO_URL = https:/$()/dailytondo.com

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES

// CHANGEME — the production registration secret, matching Rails credentials
// `tondo.app_secret`. Same caveat as the URL above: builds fine while wrong,
// caught only when registration answers 401.
TONDO_APP_SECRET = CHANGEME
