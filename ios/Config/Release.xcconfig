#include "Shared.xcconfig"

// The production host. Must stay in step with `proxy.host` in
// `config/deploy.yml`; the shell builds and runs against this value without
// complaint, so the thing that catches a wrong one is App Review opening a
// dead host. The `$()` is what stops xcconfig treating `//` as a comment.
TONDO_URL = https:/$()/dailytondo.com

SWIFT_OPTIMIZATION_LEVEL = -O
SWIFT_COMPILATION_MODE = wholemodule
VALIDATE_PRODUCT = YES

// The production registration secret, matching Rails credentials
// `tondo.app_secret`. Same caveat as the URL above: builds fine while wrong,
// caught only when registration answers 401 and the shell degrades to the
// public landing page with no sign-in.
//
// The real value does NOT live in this tracked file. `Secrets.xcconfig` is
// gitignored and included LAST so its assignment wins; generate it with
// `script/ios-secrets`. The placeholder below is what a fresh clone gets, so a
// missing secrets file is a 401 you can read rather than a build that dies.
TONDO_APP_SECRET = CHANGEME

#include? "Secrets.xcconfig"
