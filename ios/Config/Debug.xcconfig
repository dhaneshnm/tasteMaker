#include "Shared.xcconfig"

// `$()` splits the `//` so xcconfig does not read the rest of the line as a
// comment. This is the documented escape and it is the reason this value cannot
// simply be written out longhand.
TONDO_URL = http:/$()/localhost:3000

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
SWIFT_OPTIMIZATION_LEVEL = -Onone
GCC_OPTIMIZATION_LEVEL = 0
ONLY_ACTIVE_ARCH = YES
ENABLE_TESTABILITY = YES

// The device-registration secret (story 0015). Rails credentials
// `tondo.app_secret` wins over ENV["TONDO_APP_SECRET"] (see
// DeviceRegistrationsController.expected_app_secret), so a dev server run the
// normal way (no ENV override) expects the credentials value, not this
// literal. `Secrets.xcconfig` carries that value when generated by
// `script/ios-secrets`; included LAST so its assignment wins, same pattern as
// Release.xcconfig. This literal is only the fallback for a fresh clone with
// no secrets file yet.
TONDO_APP_SECRET = dev-tondo-app-secret

#include? "Secrets.xcconfig"
